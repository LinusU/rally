{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rally-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",
	"observability": { "enabled": true },
	// Release lapsed claims every 10 minutes so the activity log and status stay current overnight.
	"triggers": { "crons": ["*/10 * * * *"] },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "rally",
			"database_id": "8b846f22-f300-463a-9755-953095cd9e3d",
			"migrations_dir": "migrations"
		}
	]
}
